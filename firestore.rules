rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)donarajwade@gmail.com'))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // User Transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Leaderboard collection
    match /leaderboards/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // App Settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Real Online Users Presence collection
    match /online_users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin() || isSignedIn();
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
